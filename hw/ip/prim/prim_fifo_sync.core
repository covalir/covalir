CAPI=2:
# Copyright 2026 CovalIR Contributors
# Licensed under the Apache License, Version 2.0

name: "covalir:prim:fifo_sync:0.1"
description: "Technology-independent low-latency synchronous FIFO with valid/ready handshake."

filesets:
  files_rtl:
    files:
      - rtl/prim_fifo_sync.sv
    file_type: systemVerilogSource
  files_dv:
    files:
      - dv/tb_prim_fifo_sync.cpp
    file_type: cppSource

targets:
  default: &default_target
    filesets:
      - files_rtl
  lint:
    <<: *default_target
    default_tool: verilator
    toplevel: prim_fifo_sync
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"
          - "-Werror-WIDTH"
          - "-Werror-UNUSED"
  sim:
    <<: *default_target
    filesets_append:
      - files_dv
    default_tool: verilator
    toplevel: prim_fifo_sync
    tools:
      verilator:
        mode: cc
        verilator_options:
          - "-Wall"
          - "-Werror-WIDTH"
          - "-Werror-UNUSED"
          - "--exe"
          - "--build"
          - "-j"
          - "0"
          - "-O3"
